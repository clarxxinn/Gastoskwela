<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="5dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="#F0F2FA"
    app:strokeWidth="1dp">

    <LinearLayout
        android:id="@+id/expenseRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">

            <View
                android:id="@+id/expenseIconBackground"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_expense_category_circle" />

            <TextView
                android:id="@+id/tvExpenseIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🍴"
                android:textSize="19sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="11dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvExpenseCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pagkain"
                android:textColor="#1F2937"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_semibold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvExpenseDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Oct 9, 2026"
                android:textColor="#929AB2"
                android:textSize="10sp"
                android:fontFamily="@font/poppins_regular" />

            <TextView
                android:id="@+id/tvExpenseDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:textSize="10sp"
                android:textColor="#929AB2" />

            <TextView
                android:id="@+id/tvExpenseNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:textSize="10sp"
                android:textColor="#929AB2" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvExpenseAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="-₱45.00"
            android:textColor="#EF4444"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_bold" />

        <View
            android:id="@+id/btnEditExpense"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <View
            android:id="@+id/btnDeleteExpense"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>