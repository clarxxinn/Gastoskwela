<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_gastoskwela_splash"
                android:contentDescription="Gastoskwela logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gastoskwela"
                    android:textSize="18sp"
                    android:textColor="#1F2937"
                    android:fontFamily="@font/poppins_bold" />

                <TextView
                    android:id="@+id/tvHomeDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Today"
                    android:textSize="11sp"
                    android:textColor="#6B7280"
                    android:fontFamily="@font/poppins_regular" />
            </LinearLayout>

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="♧"
                android:textColor="#1F2937"
                android:textSize="25sp"
                android:contentDescription="Notifications" />
        </LinearLayout>

        <!-- REMAINING ALLOWANCE -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#5B3FD9"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="17dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Remaining Allowance"
                        android:textSize="12sp"
                        android:textColor="#F2EDFF"
                        android:fontFamily="@font/poppins_medium" />

                    <TextView
                        android:id="@+id/tvHomeBudgetPercentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0% remaining"
                        android:textSize="11sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/poppins_semibold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvHomeBalance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="₱0.00"
                    android:textSize="28sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/poppins_bold" />

                <ProgressBar
                    android:id="@+id/progressHomeBudget"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#FFFFFF"
                    android:progressBackgroundTint="#8F7BEC" />

                <TextView
                    android:id="@+id/tvHomeBudgetInsight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Add your allowance to get started."
                    android:textSize="10sp"
                    android:textColor="#E6DFFF"
                    android:fontFamily="@font/poppins_regular" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SUMMARY CARDS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#E9ECF5"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Today's Spending"
                        android:textSize="10sp"
                        android:textColor="#6B7280"
                        android:fontFamily="@font/poppins_medium" />

                    <TextView
                        android:id="@+id/tvHomeExpenses"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="₱0.00"
                        android:textSize="18sp"
                        android:textColor="#1F2937"
                        android:fontFamily="@font/poppins_bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#E9ECF5"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Total Allowance"
                        android:textSize="10sp"
                        android:textColor="#6B7280"
                        android:fontFamily="@font/poppins_medium" />

                    <TextView
                        android:id="@+id/tvHomeAllowance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="₱0.00"
                        android:textSize="18sp"
                        android:textColor="#1F2937"
                        android:fontFamily="@font/poppins_bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- QUICK ACTIONS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:text="Quick Actions"
            android:textSize="16sp"
            android:textColor="#1F2937"
            android:fontFamily="@font/poppins_bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHomeExpenses"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_weight="1"
                android:text="＋\nAdd Expense"
                android:textAllCaps="false"
                android:textColor="#5B3FD9"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="12dp"
                app:strokeColor="#E9ECF5"
                app:strokeWidth="1dp" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHomeAllowance"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_weight="1"
                android:text="＋\nAdd Allowance"
                android:textAllCaps="false"
                android:textColor="#F59E0B"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="12dp"
                app:strokeColor="#E9ECF5"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHomePayments"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_weight="1"
                android:text="＋\nAdd Payment"
                android:textAllCaps="false"
                android:textColor="#EF4444"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="12dp"
                app:strokeColor="#E9ECF5"
                app:strokeWidth="1dp" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHomeReports"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_weight="1"
                android:text="▥\nView Reports"
                android:textAllCaps="false"
                android:textColor="#5B3FD9"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="12dp"
                app:strokeColor="#E9ECF5"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <!-- RECENT EXPENSES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Recent Expenses"
                android:textColor="#1F2937"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_bold" />

            <TextView
                android:id="@+id/btnSeeAllExpenses"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="See All"
                android:textColor="#5B3FD9"
                android:textSize="11sp"
                android:fontFamily="@font/poppins_medium"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHomeEmptyTransactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No expenses yet."
            android:textColor="#6B7280"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_regular" />

        <LinearLayout
            android:id="@+id/homeTransactionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- UPCOMING PAYMENTS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Upcoming Payments"
                android:textColor="#1F2937"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_bold" />

            <TextView
                android:id="@+id/btnSeeAllPayments"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="See All"
                android:textColor="#5B3FD9"
                android:textSize="11sp"
                android:fontFamily="@font/poppins_medium"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHomeEmptyPayments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No upcoming school payments."
            android:textColor="#6B7280"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_regular" />

        <LinearLayout
            android:id="@+id/homePaymentsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>