<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFF">

    <!-- HEADER -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <ImageButton
            android:id="@+id/btnAllowanceBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_add_expense_back"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Allowance"
            android:textColor="#1F2937"
            android:textSize="17sp"
            android:fontFamily="@font/poppins_semibold" />
    </FrameLayout>

    <!-- TABS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tabAllowanceHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvAllowanceHistoryTab"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="History"
                android:textColor="#6547ED"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_semibold" />

            <View
                android:id="@+id/indicatorAllowanceHistory"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="#6547ED" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabAllowanceSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvAllowanceSettingsTab"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Settings"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_medium" />

            <View
                android:id="@+id/indicatorAllowanceSettings"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:visibility="invisible"
                android:background="#6547ED" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E6EAF4" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="24dp">

            <!-- HISTORY SCREEN -->
            <LinearLayout
                android:id="@+id/allowanceHistorySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#F0EEFF"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Current Balance"
                                android:textColor="#374151"
                                android:textSize="12sp"
                                android:fontFamily="@font/poppins_medium" />

                            <TextView
                                android:id="@+id/tvAllowanceBalance"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="₱0.00"
                                android:textColor="#111827"
                                android:textSize="25sp"
                                android:fontFamily="@font/poppins_bold" />
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_allowance_wallet">

                            <ImageView
                                android:layout_width="29dp"
                                android:layout_height="29dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_nav_allowance"
                                android:contentDescription="Wallet"
                                android:tint="#6547ED" />
                        </FrameLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- RECEIVED / SPENT -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Received"
                            android:textColor="#6B7280"
                            android:textSize="11sp"
                            android:fontFamily="@font/poppins_regular" />

                        <TextView
                            android:id="@+id/tvTotalAllowance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="₱0.00"
                            android:textColor="#1F2937"
                            android:textSize="17sp"
                            android:fontFamily="@font/poppins_bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="43dp"
                        android:background="#E4E7F0" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Spent"
                            android:textColor="#6B7280"
                            android:textSize="11sp"
                            android:fontFamily="@font/poppins_regular" />

                        <TextView
                            android:id="@+id/tvAllowanceSpent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="₱0.00"
                            android:textColor="#EF4444"
                            android:textSize="17sp"
                            android:fontFamily="@font/poppins_bold" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddAllowance"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="17dp"
                    android:text="+   Add Allowance"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_semibold"
                    app:backgroundTint="#6547ED"
                    app:cornerRadius="11dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Allowance History"
                        android:textColor="#1F2937"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppins_semibold" />

                    <TextView
                        android:id="@+id/tvAllowanceCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 records"
                        android:textColor="#8C94AB"
                        android:textSize="10sp"
                        android:fontFamily="@font/poppins_regular" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEmptyAllowance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:gravity="center"
                    android:text="No allowance records yet."
                    android:textColor="#6B7280"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_regular" />

                <LinearLayout
                    android:id="@+id/allowanceListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvAllowanceSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="#8C94AB"
                    android:textSize="11sp"
                    android:fontFamily="@font/poppins_regular" />

            </LinearLayout>

            <!-- SETTINGS SCREEN -->
            <LinearLayout
                android:id="@+id/allowanceSettingsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="15dp"
                    app:strokeColor="#E8EBF7"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="17dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Default Allowance Frequency"
                            android:textColor="#1F2937"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_semibold" />

                        <TextView
                            android:id="@+id/tvAllowanceFrequency"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Daily"
                            android:textColor="#6547ED"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_medium" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="This schedule is a preference only. It does not automatically add money."
                            android:textColor="#6B7280"
                            android:textSize="11sp"
                            android:fontFamily="@font/poppins_regular" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnChangeAllowanceFrequency"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_marginTop="14dp"
                            android:text="Change Frequency"
                            android:textAllCaps="false"
                            android:textColor="#6547ED"
                            android:fontFamily="@font/poppins_semibold"
                            app:strokeColor="#6547ED"
                            app:cornerRadius="11dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>