<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFF">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnAllowanceBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_add_expense_back"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Allowance"
            android:textColor="#20263A"
            android:textSize="18sp"
            android:fontFamily="@font/poppins_semibold" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <!-- TABS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tabAllowanceOverview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvAllowanceOverviewTab"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Overview"
                android:textColor="#6547ED"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_semibold" />

            <View
                android:id="@+id/indicatorAllowanceOverview"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="#6547ED" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabAllowanceHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvAllowanceHistoryTab"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="History"
                android:textColor="#929AB2"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium" />

            <View
                android:id="@+id/indicatorAllowanceHistory"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:visibility="invisible"
                android:background="#6547ED" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8EAF4" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="28dp">

            <!-- OVERVIEW -->
            <LinearLayout
                android:id="@+id/allowanceOverviewSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- PURPLE BALANCE CARD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="130dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="20dp"
                    android:background="@drawable/bg_allowance_balance">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Current Balance"
                            android:textColor="#EAE3FF"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins_medium" />

                        <TextView
                            android:id="@+id/tvAllowanceBalance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="₱0.00"
                            android:textColor="#FFFFFF"
                            android:textSize="28sp"
                            android:fontFamily="@font/poppins_bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Your remaining student budget"
                            android:textColor="#EAE3FF"
                            android:textSize="10sp"
                            android:fontFamily="@font/poppins_regular" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_allowance_wallet"
                        android:contentDescription="Wallet" />
                </LinearLayout>

                <!-- TOTAL CARDS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:orientation="vertical"
                        android:padding="13dp"
                        android:background="@drawable/bg_allowance_summary">

                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:src="@drawable/ic_allowance_income"
                            android:contentDescription="Received" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Total Received"
                            android:textColor="#6B7280"
                            android:textSize="11sp"
                            android:fontFamily="@font/poppins_regular" />

                        <TextView
                            android:id="@+id/tvTotalAllowance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="₱0.00"
                            android:textColor="#1F2937"
                            android:textSize="17sp"
                            android:fontFamily="@font/poppins_bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:orientation="vertical"
                        android:padding="13dp"
                        android:background="@drawable/bg_allowance_summary">

                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:src="@drawable/ic_allowance_spent"
                            android:contentDescription="Spent" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Total Spent"
                            android:textColor="#6B7280"
                            android:textSize="11sp"
                            android:fontFamily="@font/poppins_regular" />

                        <TextView
                            android:id="@+id/tvAllowanceSpent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="₱0.00"
                            android:textColor="#1F2937"
                            android:textSize="17sp"
                            android:fontFamily="@font/poppins_bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ADD ALLOWANCE BEFORE SUMMARY -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddAllowance"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="15dp"
                    android:text="Add Allowance"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/poppins_semibold"
                    app:icon="@drawable/ic_allowance_plus"
                    app:iconTint="#FFFFFF"
                    app:iconGravity="textStart"
                    app:iconPadding="9dp"
                    app:backgroundTint="#6547ED"
                    app:cornerRadius="12dp" />

                <!-- FINANCIAL SUMMARY -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="23dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Financial Summary"
                        android:textColor="#1F2937"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppins_semibold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Received / Spent"
                        android:textColor="#929AB2"
                        android:textSize="10sp"
                        android:fontFamily="@font/poppins_regular" />
                </LinearLayout>

                <GridLayout
                    android:id="@+id/allowanceQuickSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:columnCount="2"
                    android:orientation="horizontal" />

                <!-- RECENT ALLOWANCE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="23dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Recent Allowance"
                        android:textColor="#1F2937"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppins_semibold" />

                    <TextView
                        android:id="@+id/tvAllowanceCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 records"
                        android:textColor="#929AB2"
                        android:textSize="10sp"
                        android:fontFamily="@font/poppins_regular" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEmptyAllowance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:text="No allowance records yet."
                    android:textColor="#929AB2"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_regular" />

                <LinearLayout
                    android:id="@+id/allowanceListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- HISTORY -->
            <LinearLayout
                android:id="@+id/allowanceHistorySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Financial History"
                        android:textColor="#1F2937"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppins_semibold" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_allowance_calendar"
                        android:contentDescription="Calendar" />
                </LinearLayout>

                <!-- PERIOD SELECTOR -->
                <TextView
                    android:id="@+id/btnOverviewPeriod"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="Daily  ⌄"
                    android:textColor="#6547ED"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_semibold"
                    android:background="@drawable/bg_allowance_period"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- DATE NAVIGATION -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnOverviewPrevious"
                        android:layout_width="40dp"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:text="‹"
                        android:textSize="28sp"
                        android:textColor="#6547ED"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnOverviewDate"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Select date"
                        android:textColor="#374151"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins_medium"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnOverviewNext"
                        android:layout_width="40dp"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:text="›"
                        android:textSize="28sp"
                        android:textColor="#6547ED"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- HISTORY BALANCE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/bg_allowance_balance">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Remaining Balance"
                        android:textColor="#EAE3FF"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins_medium" />

                    <TextView
                        android:id="@+id/tvHistoryBalance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="₱0.00"
                        android:textColor="#FFFFFF"
                        android:textSize="27sp"
                        android:fontFamily="@font/poppins_bold" />

                    <TextView
                        android:id="@+id/tvOverviewOpening"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Opening balance: ₱0.00"
                        android:textColor="#EAE3FF"
                        android:textSize="10sp"
                        android:fontFamily="@font/poppins_regular" />
                </LinearLayout>

                <!-- HISTORY TOTALS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:background="@drawable/bg_allowance_summary">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Received"
                            android:textColor="#6B7280"
                            android:textSize="11sp"
                            android:fontFamily="@font/poppins_regular" />

                        <TextView
                            android:id="@+id/tvHistoryReceived"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="₱0.00"
                            android:textColor="#16A34A"
                            android:textSize="17sp"
                            android:fontFamily="@font/poppins_bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:background="@drawable/bg_allowance_summary">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Spent"
                            android:textColor="#6B7280"
                            android:textSize="11sp"
                            android:fontFamily="@font/poppins_regular" />

                        <TextView
                            android:id="@+id/tvHistorySpent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="₱0.00"
                            android:textColor="#DC2626"
                            android:textSize="17sp"
                            android:fontFamily="@font/poppins_bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- EXPENSE BREAKDOWN -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Where Your Allowance Went"
                    android:textColor="#1F2937"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppins_semibold" />

                <TextView
                    android:id="@+id/tvOverviewEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:text="No expenses for this period."
                    android:textColor="#929AB2"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_regular" />

                <LinearLayout
                    android:id="@+id/overviewExpenseList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>