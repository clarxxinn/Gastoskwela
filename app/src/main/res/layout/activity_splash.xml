<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <LinearLayout
        android:id="@+id/splashContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.43">

        <ImageView
            android:id="@+id/imgSplashLogo"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:contentDescription="Gastoskwela logo"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_gastoskwela_splash" />

        <TextView
            android:id="@+id/tvSplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="-0.025"
            android:text="Gastoskwela"
            android:textColor="#FFFFFF"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/tvSplashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0"
            android:lineSpacingExtra="2dp"
            android:text="Track Your Baon.&#10;Manage Your Gastos."
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/splashProgressTrack"
        android:layout_width="112dp"
        android:layout_height="6dp"
        android:layout_marginBottom="68dp"
        android:background="@drawable/bg_splash_progress_track"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/splashProgressFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_splash_progress_fill" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>