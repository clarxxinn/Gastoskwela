<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center"
        android:text="Reports"
        android:textColor="#1F2937"
        android:textSize="17sp"
        android:fontFamily="@font/poppins_semibold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="30dp">

            <!-- FILTERS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReportPeriod"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="Monthly  ⌄"
                    android:textAllCaps="false"
                    android:textColor="#374151"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_medium"
                    app:cornerRadius="12dp"
                    app:strokeColor="#E6EAF5"
                    app:backgroundTint="#F0F2FF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReportMonth"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1.2"
                    android:text="October 2026  ⌄"
                    android:textAllCaps="false"
                    android:textColor="#374151"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_medium"
                    app:cornerRadius="12dp"
                    app:strokeColor="#E6EAF5"
                    app:backgroundTint="#FFFFFF" />
            </LinearLayout>

            <!-- TOTAL EXPENSES -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="17dp"
                app:strokeColor="#EDF0F8"
                app:strokeWidth="1dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Total Expenses"
                            android:textColor="#6B7280"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins_medium" />

                        <TextView
                            android:id="@+id/tvReportTotalExpenses"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="₱0.00"
                            android:textColor="#111827"
                            android:textSize="27sp"
                            android:fontFamily="@font/poppins_bold" />

                        <TextView
                            android:id="@+id/tvReportComparison"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="No previous period data"
                            android:textColor="#6B7280"
                            android:textSize="11sp"
                            android:fontFamily="@font/poppins_medium" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/ic_nav_reports"
                        android:tint="#6547ED"
                        android:contentDescription="Reports" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- DONUT CHART -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Spending by Category"
                android:textColor="#1F2937"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_semibold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.clarxxinn.gastoskwela.views.ReportsChartView
                    android:id="@+id/donutChart"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_weight="1.15" />

                <LinearLayout
                    android:id="@+id/categoryLegendContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvReportNoCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="No expenses for this period."
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_regular"
                android:visibility="gone" />

            <!-- WEEKLY BAR CHART -->
            <TextView
                android:id="@+id/tvTrendTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Weekly Spending Trend"
                android:textColor="#1F2937"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_semibold" />

            <com.clarxxinn.gastoskwela.views.ReportsChartView
                android:id="@+id/weeklyChart"
                android:layout_width="match_parent"
                android:layout_height="205dp"
                android:layout_marginTop="12dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>